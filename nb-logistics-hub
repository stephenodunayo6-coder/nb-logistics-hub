<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>NB Logistics Hub — Motorcycle Delivery</title>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,Helvetica,sans-serif;
    background:#07182f;
    color:#fff;
    min-height:100vh;
}

/* =========================
   HERO
========================= */

.hero{
    position:relative;
    min-height:430px;
    overflow:hidden;
    background:#06162c;
}

.hero img{
    width:100%;
    height:430px;
    object-fit:cover;
    display:block;
}

.hero:after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(
        90deg,
        rgba(3,15,34,.15),
        rgba(3,15,34,.05) 55%,
        rgba(3,15,34,.08)
    );
}

.hero-content{
    position:absolute;
    z-index:2;
    left:6%;
    bottom:38px;
    max-width:560px;
}

.hero h1{
    font-size:clamp(34px,6vw,64px);
    margin:0 0 10px;
    font-weight:800;
    letter-spacing:-1px;
    text-shadow:0 3px 15px rgba(0,0,0,.35);
}

.hero p{
    font-size:clamp(17px,2.2vw,24px);
    margin:0;
    font-weight:600;
    text-shadow:0 2px 10px rgba(0,0,0,.5);
}

/* =========================
   MAIN CARD
========================= */

.wrap{
    max-width:850px;
    margin:-30px auto 50px;
    padding:0 18px;
    position:relative;
    z-index:3;
}

.card{
    background:#fff;
    color:#13213a;
    border-radius:24px;
    padding:28px;
    box-shadow:0 18px 55px rgba(0,0,0,.3);
}

.badge{
    display:inline-block;
    background:#ffcf00;
    color:#07182f;
    font-weight:800;
    padding:8px 14px;
    border-radius:999px;
    margin-bottom:12px;
}

h2{
    margin:0 0 8px;
    font-size:30px;
    color:#07182f;
}

.sub{
    color:#637086;
    margin:0 0 22px;
}

/* =========================
   FORM
========================= */

.grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:16px;
}

.field{
    margin-bottom:2px;
}

.field.full{
    grid-column:1/-1;
}

label{
    display:block;
    font-weight:700;
    margin-bottom:7px;
}

input,
textarea{
    width:100%;
    padding:14px 15px;
    border:1px solid #d8dfeb;
    border-radius:12px;
    font-size:16px;
    outline:none;
    background:#f8fafc;
}

input:focus,
textarea:focus{
    border-color:#ffcf00;
    box-shadow:0 0 0 3px rgba(255,207,0,.18);
}

textarea{
    min-height:100px;
    resize:vertical;
}

/* =========================
   BUTTONS
========================= */

button{
    width:100%;
    border:0;
    border-radius:13px;
    padding:15px;
    font-size:17px;
    font-weight:800;
    cursor:pointer;
}

.submit{
    background:#ffcf00;
    color:#07182f;
    margin-top:8px;
}

.submit:hover{
    filter:brightness(.96);
}

.submit:disabled{
    opacity:.7;
    cursor:not-allowed;
}

.track{
    background:#07182f;
    color:#fff;
}

.again{
    background:#e9eef5;
    color:#07182f;
}

/* =========================
   RESULT
========================= */

.result{
    display:none;
    margin-top:22px;
    background:#f2f7ff;
    border:1px solid #d7e4f7;
    border-radius:18px;
    padding:20px;
}

.result h3{
    margin-top:0;
    color:#07182f;
}

.request-code{
    font-size:25px;
    font-weight:900;
    color:#0b56a4;
    word-break:break-word;
}

.details{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
    margin:15px 0;
}

.detail{
    background:#fff;
    border-radius:12px;
    padding:12px;
}

.detail strong{
    display:block;
    font-size:12px;
    color:#68758a;
    text-transform:uppercase;
    margin-bottom:4px;
}

.actions{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
    margin-top:15px;
}

.note{
    font-size:13px;
    color:#64748b;
    margin-top:14px;
    line-height:1.5;
}

.status{
    display:inline-block;
    background:#fff3b8;
    color:#755900;
    padding:6px 10px;
    border-radius:999px;
    font-weight:800;
    font-size:13px;
}

/* =========================
   FOOTER
========================= */

footer{
    text-align:center;
    color:#aebbd0;
    padding:0 20px 35px;
    font-size:13px;
}

/* =========================
   MOBILE
========================= */

@media(max-width:700px){

    .hero,
    .hero img{
        height:360px;
    }

    .hero-content{
        left:20px;
        right:20px;
        bottom:25px;
    }

    .grid,
    .details,
    .actions{
        grid-template-columns:1fr;
    }

    .wrap{
        margin-top:-20px;
    }

    .card{
        padding:20px;
        border-radius:20px;
    }

    h2{
        font-size:25px;
    }
}
</style>
</head>

<body>

<!-- =========================
     HERO SECTION
========================= -->

<section class="hero">

    <!-- KEEP nb-logistics-hero.png IN THE SAME FOLDER -->
    <img
        src="nb-logistics-hero.png"
        alt="NB Logistics Hub motorcycle courier carrying a delivery bag"
    >

    <div class="hero-content">

        <h1>NB Logistics Hub</h1>

        <p>
            Fast, simple and dependable motorcycle delivery across Ilorin.
        </p>

    </div>

</section>


<!-- =========================
     MAIN CONTENT
========================= -->

<main class="wrap">

    <div class="card">

        <span class="badge">
            🏍️ Motorcycle Delivery
        </span>

        <h2>
            Your Package. Our Priority.
        </h2>

        <p class="sub">
            Tell us where your package is going and we'll handle the delivery.
        </p>


        <!-- =========================
             REQUEST FORM
        ========================= -->

        <form id="requestForm">

            <div class="grid">

                <!-- CUSTOMER NAME -->

                <div class="field">

                    <label for="customerName">
                        Customer Name
                    </label>

                    <input
                        id="customerName"
                        type="text"
                        placeholder="Enter your name"
                        required
                    >

                </div>


                <!-- PHONE -->

                <div class="field">

                    <label for="phone">
                        Phone Number
                    </label>

                    <input
                        id="phone"
                        type="tel"
                        placeholder="Enter phone number"
                        required
                    >

                </div>


                <!-- PICKUP -->

                <div class="field">

                    <label for="pickup">
                        Pickup Location
                    </label>

                    <input
                        id="pickup"
                        type="text"
                        placeholder="Where should we pick it up?"
                        required
                    >

                </div>


                <!-- DESTINATION -->

                <div class="field">

                    <label for="destination">
                        Delivery Location
                    </label>

                    <input
                        id="destination"
                        type="text"
                        placeholder="Where should we deliver it?"
                        required
                    >

                </div>


                <!-- PACKAGE -->

                <div class="field full">

                    <label for="packageDetails">
                        Package Details
                    </label>

                    <textarea
                        id="packageDetails"
                        placeholder="What are you sending?"
                    ></textarea>

                </div>


                <!-- TIME -->

                <div class="field">

                    <label for="preferredTime">
                        Preferred Time
                    </label>

                    <input
                        id="preferredTime"
                        type="time"
                    >

                </div>

            </div>


            <!-- SUBMIT -->

            <button
                class="submit"
                id="submitBtn"
                type="submit"
            >
                🏍️ Submit Delivery Request
            </button>

        </form>


        <!-- =========================
             SUCCESS RESULT
        ========================= -->

        <div
            class="result"
            id="result"
        >

            <h3>
                ✅ Delivery Request Submitted
            </h3>

            <p>
                Your request number is:
            </p>

            <div
                class="request-code"
                id="requestCode"
            ></div>


            <p>
                <span class="status">
                    New — Awaiting confirmation
                </span>
            </p>


            <div class="details">


                <!-- CUSTOMER -->

                <div class="detail">

                    <strong>
                        Customer
                    </strong>

                    <span id="rCustomer"></span>

                </div>


                <!-- PICKUP -->

                <div class="detail">

                    <strong>
                        Pickup
                    </strong>

                    <span id="rPickup"></span>

                </div>


                <!-- DESTINATION -->

                <div class="detail">

                    <strong>
                        Destination
                    </strong>

                    <span id="rDestination"></span>

                </div>


                <!-- PACKAGE -->

                <div class="detail">

                    <strong>
                        Package
                    </strong>

                    <span id="rPackage"></span>

                </div>


                <!-- TIME -->

                <div class="detail">

                    <strong>
                        Preferred Time
                    </strong>

                    <span id="rTime"></span>

                </div>


                <!-- FEE -->

                <div class="detail">

                    <strong>
                        Delivery Fee
                    </strong>

                    <span>
                        ₦0 — to be confirmed
                    </span>

                </div>

            </div>


            <!-- SECURITY NOTE -->

            <p class="note">

                Please save your
                <strong>request number</strong>
                and
                <strong>phone number</strong>.

                You will need both to securely track your delivery.

            </p>


            <!-- ACTION BUTTONS -->

            <div class="actions">

                <button
                    class="track"
                    type="button"
                    onclick="window.location.href='NB_Logistics_Track.html'"
                >
                    🔎 Track My Delivery
                </button>


                <button
                    class="again"
                    type="button"
                    onclick="location.reload()"
                >
                    ➕ Make Another Request
                </button>

            </div>

        </div>

    </div>

</main>


<!-- =========================
     FOOTER
========================= -->

<footer>

    NB Logistics Hub — Ilorin Motorcycle Delivery

    <br>

    Your Package. Our Priority.

</footer>


<!-- =========================
     SUPABASE
========================= -->

<script>

const SUPABASE_URL =
    "https://kygkgcpuiwawatugkfne.supabase.co";

const SUPABASE_KEY =
    "sb_publishable_Lq53TPVZ_i6z4nzQ8pYF6A_0NJdu-eH";


const supabaseClient =
    supabase.createClient(
        SUPABASE_URL,
        SUPABASE_KEY
    );


/* =========================
   GENERATE REQUEST NUMBER
========================= */

function generateRequestCode(){

    const now = new Date();

    const year =
        now.getFullYear();

    const month =
        String(now.getMonth() + 1)
        .padStart(2,"0");

    const day =
        String(now.getDate())
        .padStart(2,"0");

    const random =
        Math.floor(
            1000 +
            Math.random() * 9000
        );

    return `NB-${year}${month}${day}-${random}`;
}


/* =========================
   FORM ELEMENTS
========================= */

const form =
    document.getElementById(
        "requestForm"
    );

const submitBtn =
    document.getElementById(
        "submitBtn"
    );

const result =
    document.getElementById(
        "result"
    );


/* =========================
   SUBMIT REQUEST
========================= */

form.addEventListener(
    "submit",
    async function(e){

        e.preventDefault();


        /* Disable button */

        submitBtn.disabled = true;

        submitBtn.textContent =
            "Submitting...";


        /* Get form values */

        const customerName =
            document
            .getElementById("customerName")
            .value
            .trim();


        const phone =
            document
            .getElementById("phone")
            .value
            .trim();


        const pickup =
            document
            .getElementById("pickup")
            .value
            .trim();


        const destination =
            document
            .getElementById("destination")
            .value
            .trim();


        const packageDetails =
            document
            .getElementById("packageDetails")
            .value
            .trim();


        const preferredTime =
            document
            .getElementById("preferredTime")
            .value;


        /* Generate request number */

        const requestCode =
            generateRequestCode();


        /* =========================
           INSERT INTO SUPABASE
        ========================= */

        const {
            data,
            error
        } = await supabaseClient

            .from("delivery_requests")

            .insert({

                request_code:
                    requestCode,

                customer_name:
                    customerName,

                phone:
                    phone,

                pickup_location:
                    pickup,

                delivery_location:
                    destination,

                package_details:
                    packageDetails || null,

                preferred_time:
                    preferredTime || null,

                delivery_fee:
                    0,

                status:
                    "New"

            })

            .select()

            .single();


        /* =========================
           ERROR
        ========================= */

        if(error){

            console.error(error);

            alert(
                "Could not submit your delivery request. Please try again."
            );

            submitBtn.disabled = false;

            submitBtn.textContent =
                "🏍️ Submit Delivery Request";

            return;
        }


        /* =========================
           SHOW SUCCESS
        ========================= */

        document
            .getElementById("requestCode")
            .textContent =
                data.request_code;


        document
            .getElementById("rCustomer")
            .textContent =
                data.customer_name;


        document
            .getElementById("rPickup")
            .textContent =
                data.pickup_location;


        document
            .getElementById("rDestination")
            .textContent =
                data.delivery_location;


        document
            .getElementById("rPackage")
            .textContent =
                data.package_details ||
                "Not specified";


        document
            .getElementById("rTime")
            .textContent =
                data.preferred_time ||
                "Any available time";


        /* Show result */

        result.style.display =
            "block";


        /* Scroll to confirmation */

        result.scrollIntoView({

            behavior:"smooth",

            block:"start"

        });


        /* Change button */

        submitBtn.textContent =
            "Request Submitted ✓";

    }

);

</script>

</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>NB Logistics Hub — Delivery Receipt</title>

<style>
*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,Helvetica,sans-serif;
    background:
        radial-gradient(circle at top left,#183d68 0%,transparent 35%),
        linear-gradient(135deg,#06111f,#0b1d32 55%,#071321);
