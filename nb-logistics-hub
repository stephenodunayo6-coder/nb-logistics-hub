    color:#182230;
    border-radius:24px;
    overflow:hidden;
    box-shadow:0 25px 60px rgba(0,0,0,.35);
}

.receipt-top{
    background:linear-gradient(135deg,#ffd400,#ffb800);
    color:#071321;
    padding:28px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
}

.receipt-top h2{
    margin:0 0 6px;
    font-size:26px;
}

.receipt-top p{
    margin:0;
    font-size:14px;
}

.check{
    width:64px;
    height:64px;
    border-radius:50%;
    background:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:32px;
}

.receipt-body{
    padding:30px;
}

.status{
    text-align:center;
    margin-bottom:28px;
}

.status-badge{
    display:inline-block;
    padding:10px 18px;
    border-radius:999px;
    background:#e8f8ee;
    color:#138a43;
    font-weight:bold;
    font-size:14px;
}

.section-title{
    font-size:13px;
    font-weight:bold;
    color:#7a8795;
    text-transform:uppercase;
    letter-spacing:.8px;
    margin:24px 0 12px;
}

.info-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:14px;
}

.info{
    background:#f5f7fa;
    border-radius:14px;
    padding:16px;
}

.info-label{
    font-size:12px;
    color:#7a8795;
    margin-bottom:6px;
}

.info-value{
    font-size:16px;
    font-weight:bold;
    word-break:break-word;
}

.route{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
}

.location{
    border:1px solid #e2e7ed;
    border-radius:16px;
    padding:18px;
}

.location.pickup{
    border-left:5px solid #2563eb;
}

.location.destination{
    border-left:5px solid #16a34a;
}

.location-label{
    font-size:12px;
    color:#7a8795;
    font-weight:bold;
    text-transform:uppercase;
    margin-bottom:8px;
}

.location-value{
    font-size:16px;
    font-weight:bold;
    line-height:1.5;
}

.fee{
    margin-top:24px;
    background:#071321;
    color:#fff;
    border-radius:18px;
    padding:22px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.fee-label{
    color:#aebed0;
    font-size:14px;
}

.fee-value{
    color:#ffd400;
    font-size:27px;
    font-weight:bold;
}

.footer-note{
    text-align:center;
    color:#7a8795;
    font-size:12px;
    line-height:1.6;
    margin-top:28px;
    padding-top:20px;
    border-top:1px solid #e5e9ee;
}

/* BUTTONS */

.actions{
    display:flex;
    gap:12px;
    margin-top:25px;
}

button{
    flex:1;
    border:none;
    border-radius:14px;
    padding:15px;
    font-size:15px;
    font-weight:bold;
    cursor:pointer;
}

.print-btn{
    background:#ffd400;
    color:#071321;
}

.back-btn{
    background:#edf1f5;
    color:#182230;
}

/* MOBILE */

@media(max-width:650px){

    .container{
        width:94%;
        padding-top:22px;
    }

    .header h1{
        font-size:25px;
    }

    .receipt-top{
        padding:22px;
    }

    .receipt-top h2{
        font-size:21px;
    }

    .receipt-body{
        padding:20px;
    }

    .info-grid,
    .route{
        grid-template-columns:1fr;
    }

    .fee{
        flex-direction:column;
        align-items:flex-start;
        gap:8px;
    }

    .fee-value{
        font-size:24px;
    }

    .actions{
        flex-direction:column;
    }
}

/* PRINT */

@media print{

    body{
        background:#fff;
        color:#000;
    }

    .container{
        width:100%;
        padding:0;
    }

    .header{
        display:none;
    }

    .receipt{
        box-shadow:none;
        border:1px solid #ddd;
    }

    .actions{
        display:none;
    }

    .receipt-top{
        print-color-adjust:exact;
        -webkit-print-color-adjust:exact;
    }

    .fee{
        print-color-adjust:exact;
        -webkit-print-color-adjust:exact;
    }
}
</style>
</head>

