    min-height:100vh;
}

.container{
    width:min(900px,92%);
    margin:0 auto;
    padding:35px 0 50px;
}

/* HEADER */

.header{
    text-align:center;
    margin-bottom:25px;
}

.logo{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:72px;
    height:72px;
    border-radius:20px;
    background:#ffd400;
    color:#071321;
